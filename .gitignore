node_modules/
.vercel
.DS_Store
# Concurrency lock from scripts/mutate.mjs. A clean run deletes it; one
# left behind means a battery died mid-run — delete it. Never committed.
.mutate.lock
# Local secrets (e.g. YOUTUBE_API_KEY) — never commit. Vercel gets these from its
# dashboard Environment Variables, not from a file.
.env
.env.local
.env.*
# design mockups (Claude Design exports) — local-only reference, never committed
mockups/
# Private working notes. Never commit.
Users.md
INTERVIEWS.md
MEETINGS.md
# Transient per-review artifact from /code-review — findings get fixed or routed to the
# registry, then the file is deleted. Never committed.
CODE_REVIEW.md

# Review/agent worktrees live here; they are transient and must never be committed.
# A `git add -A` can sweep one into a commit.
.claude/worktrees/
